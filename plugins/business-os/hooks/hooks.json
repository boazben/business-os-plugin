{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task|Bash|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-tool.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^mcp__.*[Nn]otion",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}\"/hooks/board-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/sync-persona.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
