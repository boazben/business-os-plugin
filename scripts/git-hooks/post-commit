#!/usr/bin/env bash
# After a commit that touched a plugin's runtime content (and got a
# version bump from the pre-commit hook), push to origin and refresh the
# plugin cache in every venture folder that has that plugin installed at
# local scope, so the NEXT session opened there already has the change.
# Loops over every plugins/*/ directory so it stays correct as more
# plugins (business-os, marketing-os, ...) are added.
#
# Does not affect already-running sessions: Claude Code reads the plugin
# cache at session start only, so an open session still needs a restart.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

changed_plugins=()
for plugin_dir in plugins/*/; do
  name=$(basename "$plugin_dir")
  PLUGIN_JSON="plugins/${name}/.claude-plugin/plugin.json"
  [ -f "$PLUGIN_JSON" ] || continue
  if git diff --name-only HEAD~1 HEAD -- "$PLUGIN_JSON" 2>/dev/null | grep -q .; then
    changed_plugins+=("$name")
  fi
done

if [ "${#changed_plugins[@]}" -eq 0 ]; then
  exit 0
fi

echo "post-commit: pushing to origin"
if git remote get-url origin >/dev/null 2>&1; then
  # A new branch (a cloud session's claude/... branch) has no upstream yet: set it.
  push=(git push)
  git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || push=(git push -u origin HEAD)
  if "${push[@]}" 2>&1 | sed 's/^/  /'; then
    :
  else
    echo "  push failed (offline / no upstream?) — continuing without it" >&2
  fi
fi

installed_file="$HOME/.claude/plugins/installed_plugins.json"
if [ ! -f "$installed_file" ]; then
  echo "post-commit: no installed_plugins.json yet — nothing to propagate to"
  exit 0
fi

for name in "${changed_plugins[@]}"; do
  paths=$(jq -r --arg n "$name" '.plugins[($n + "@business-os-marketplace")]? // [] | .[] | select(.scope=="local") | .projectPath' "$installed_file" 2>/dev/null)

  if [ -z "$paths" ]; then
    echo "post-commit: no local-scope installs of $name found — nothing to propagate to yet"
    continue
  fi

  echo "post-commit: refreshing plugin cache for $name in installed venture folders"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -d "$p" ] || { echo "  skip (missing): $p"; continue; }
    echo "  $p"
    (
      cd "$p" && \
      claude plugin marketplace update business-os-marketplace >/dev/null 2>&1 && \
      claude plugin update "$name" -s local 2>&1 | sed 's/^/    /'
    ) || echo "    failed to update $p" >&2
  done <<< "$paths"
done

echo "post-commit: done. A NEW session opened in each folder above now has the change; any already-open session needs a restart to see it."
