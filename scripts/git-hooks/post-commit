#!/usr/bin/env bash
# After a commit that touched plugin-runtime content (and got a version
# bump from the pre-commit hook), push to origin and refresh the plugin
# cache in every venture folder that has business-os installed at local
# scope, so the NEXT session opened there already has the change.
#
# Does not affect already-running sessions: Claude Code reads the plugin
# cache at session start only, so an open session still needs a restart.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! git diff --name-only HEAD~1 HEAD -- .claude-plugin/plugin.json 2>/dev/null | grep -q .; then
  exit 0
fi

echo "post-commit: pushing to origin"
if git remote get-url origin >/dev/null 2>&1; then
  if git push 2>&1 | sed 's/^/  /'; then
    :
  else
    echo "  push failed (offline / no upstream?) — continuing without it" >&2
  fi
fi

installed_file="$HOME/.claude/plugins/installed_plugins.json"
if [ ! -f "$installed_file" ]; then
  echo "post-commit: no installed_plugins.json yet — nothing to propagate to"
  exit 0
fi

paths=$(jq -r '.plugins["business-os@business-os-marketplace"]? // [] | .[] | select(.scope=="local") | .projectPath' "$installed_file" 2>/dev/null)

if [ -z "$paths" ]; then
  echo "post-commit: no local-scope installs found — nothing to propagate to yet"
  exit 0
fi

echo "post-commit: refreshing plugin cache for installed venture folders"
while IFS= read -r p; do
  [ -n "$p" ] || continue
  [ -d "$p" ] || { echo "  skip (missing): $p"; continue; }
  echo "  $p"
  (
    cd "$p" && \
    claude plugin marketplace update business-os-marketplace >/dev/null 2>&1 && \
    claude plugin update business-os -s local 2>&1 | sed 's/^/    /'
  ) || echo "    failed to update $p" >&2
done <<< "$paths"

echo "post-commit: done. A NEW session opened in each folder above now has the change; any already-open session needs a restart to see it."
