#!/usr/bin/env bash
# Auto-bumps the plugin's patch version whenever a commit touches
# plugin-runtime content (agents/skills/commands/plugin hooks/manifest),
# so `claude plugin update` has something new to detect. Skipped if
# plugin.json's version was already changed by hand in this commit.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

changed=$(git diff --cached --name-only)
relevant=$(printf '%s\n' "$changed" | grep -E '^(agents/|skills/|commands/|hooks/|\.claude-plugin/plugin\.json)' || true)

[ -n "$relevant" ] || exit 0

if printf '%s\n' "$changed" | grep -qx '\.claude-plugin/plugin\.json'; then
  old_version=$(git show HEAD:.claude-plugin/plugin.json 2>/dev/null | jq -r .version 2>/dev/null || echo "")
  new_version_staged=$(jq -r .version .claude-plugin/plugin.json)
  if [ -n "$old_version" ] && [ "$old_version" != "$new_version_staged" ]; then
    echo "pre-commit: version already bumped by hand ($old_version -> $new_version_staged), skipping auto-bump"
    exit 0
  fi
fi

current=$(jq -r .version .claude-plugin/plugin.json)
IFS='.' read -r major minor patch <<< "$current"
new_version="$major.$minor.$((patch + 1))"

tmp=$(mktemp)
jq --arg v "$new_version" '.version = $v' .claude-plugin/plugin.json > "$tmp" && mv "$tmp" .claude-plugin/plugin.json
git add .claude-plugin/plugin.json

if [ -f .claude-plugin/marketplace.json ]; then
  tmp2=$(mktemp)
  jq --arg v "$new_version" '.plugins[0].version = $v' .claude-plugin/marketplace.json > "$tmp2" && mv "$tmp2" .claude-plugin/marketplace.json
  git add .claude-plugin/marketplace.json
fi

echo "pre-commit: auto-bumped business-os version $current -> $new_version"
